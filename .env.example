# ============================================
# Embedding Backend Configuration
# ============================================
# Opciones: local | vllm
EMBEDDING_BACKEND=local

# URL del servicio vLLM (solo si EMBEDDING_BACKEND=vllm)
VLLM_EMBEDDING_URL=http://localhost:8000/embed

# Modelo usado por vLLM (opcional, solo referencia)
VLLM_MODEL=intfloat/e5-mistral-7b-instruct

# ============================================
# Pipeline Configuration
# ============================================
# Directorios de entrada/salida (por defecto: data/input, data/output)
# INPUT_DIR=data/input
# OUTPUT_DIR=data/output

# Base de datos SQLite
# DATABASE_PATH=data/laley.sqlite

# ============================================
# vLLM Server Options (para referencia)
# ============================================
# Si levantás vLLM manualmente:
# vLLM_HOST=0.0.0.0
# vLLM_PORT=8000
# vLLM_MAX_TOKENS=512
# vLLM_BATCH_SIZE=32

# ============================================
# SentenceTransformers Options (modo local)
# ============================================
# LOCAL_MODEL_NAME=intfloat/multilingual-e5-base
# LOCAL_DEVICE=cpu  # cpu o cuda